#pragma once

#include <vector>
#include <cstdint>

struct Spot {
    int brand;
    int pos;
    int stocks;
};

struct MapConfig {
    int height;
    int width;
    std::vector<std::vector<int>> cells;
};

struct GameConfig {
    long long startsAt;

    std::vector<int> daySeconds;
    std::vector<int> daySteps;

    int getDaySteps(int day) const {
        if (day < 0 || day >= static_cast<int>(daySteps.size())) return 0;
        return daySteps[day];
    }

    MapConfig map;

    std::vector<Spot> spots;
    std::vector<int> initialAgentPositions;

    int fuelLimit;

    int players;
    int busyThreshold;
    int jammedThreshold;
};
