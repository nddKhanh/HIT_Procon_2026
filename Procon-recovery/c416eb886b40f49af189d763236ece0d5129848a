@echo off
chcp 65001 >nul
setlocal enabledelayedexpansion

set CXX=
set CXXFLAGS=
set LINKFLAGS=

where cl >nul 2>&1
if !errorlevel! equ 0 (
    set "CXX=cl"
    set "CXXFLAGS=/nologo /std:c++17 /EHsc /Iinclude /Ithird_party"
    set "LINKFLAGS=winhttp.lib"
    echo [INFO] Tim thay Microsoft C/C++ compiler (MSVC). Su dung WinHTTP-compatible build.
) else (
    where g++ >nul 2>&1
    if !errorlevel! equ 0 (
        set "CXX=g++"
        set "CXXFLAGS=-std=c++17 -O2 -Iinclude -Ithird_party"
        set "LINKFLAGS=-lwinhttp"
        echo [INFO] Tim thay g++ tren he thong. Build theo che do MinGW.
    ) else (
        echo [LOI] Khong tim thay compiler phu hop.
        echo [LOI] Hay mo 'x64 Native Tools Command Prompt for VS 2022' hoac cai dat Visual Studio Build Tools.
        goto end
    )
)

set CORE_SRC=src/io/JsonReader.cpp src/io/JsonWriter.cpp src/map/Map.cpp src/solver/ActionValidator.cpp src/solver/PathFinder.cpp src/solver/Solver.cpp src/solver/SpotAssigner.cpp
set API_SRC=src/api/HttpClient.cpp src/api/GameApiClient.cpp

if "%1"=="runner" (
    echo [DANG BIEN DICH VA CHAY AGENT DEBUGGER RUNNER]...
    if "%CXX%"=="cl" (
        %CXX% %CXXFLAGS% tests/test_runner.cpp %CORE_SRC% /Fe:test_runner.exe %LINKFLAGS%
    ) else (
        %CXX% %CXXFLAGS% tests/test_runner.cpp %CORE_SRC% -o test_runner.exe %LINKFLAGS%
    )
    if !errorlevel! equ 0 (
        type demo_input.json | .\test_runner.exe
    ) else (
        echo [LOI] Bien dich that bai!
    )
    goto end
)

if "%1"=="test" (
    echo [DANG BIEN DICH VA CHAY UNIT TESTS]...
    if "%CXX%"=="cl" (
        %CXX% %CXXFLAGS% tests/test_all.cpp %CORE_SRC% /Fe:test_all.exe %LINKFLAGS%
    ) else (
        %CXX% %CXXFLAGS% tests/test_all.cpp %CORE_SRC% -o test_all.exe %LINKFLAGS%
    )
    if !errorlevel! equ 0 (
        echo [DANG CHAY CAC BAI TEST]:
        .\test_all.exe
    ) else (
        echo [LOI] Bien dich that bai!
    )
    goto end
)

if "%1"=="clean" (
    echo [DANG DON DEP CAC FILE EXECUTABLE]...
    if exist HexaUdon.exe del HexaUdon.exe
    if exist test_all.exe del test_all.exe
    if exist test_runner.exe del test_runner.exe
    echo Hoan tat!
    goto end
)

echo [DANG BIEN DICH CHUONG TRINH CHINH] HexaUdon.exe...
echo   (Bao gom API client de ket noi server thi dau)
if "%CXX%"=="cl" (
    %CXX% %CXXFLAGS% src/main.cpp %CORE_SRC% %API_SRC% /Fe:HexaUdon.exe %LINKFLAGS%
) else (
    %CXX% %CXXFLAGS% src/main.cpp %CORE_SRC% %API_SRC% -o HexaUdon.exe %LINKFLAGS%
)
if !errorlevel! equ 0 (
    echo [THANH CONG] Da tao file HexaUdon.exe!
    echo.
    echo Cach su dung:
    echo   Thi dau:  HexaUdon.exe --server https://procon26.haui.ac.vn --token YOUR_TOKEN --match MATCH_ID
    echo   Local:    HexaUdon.exe --stdin
    echo   Tro giup: HexaUdon.exe --help
) else (
    echo [LOI] Bien dich that bai!
    echo [LOI] WinHTTP can phai duoc build bang MSVC tren Windows.
)

:end
